{
  "name": "professional-starmap",
  "version": "1.0.0",
  "description": "专业星图 - 大学专业选择指南",
  "private": true,
  "scripts": {
    "lint": "eslint js/ --fix",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md}\"",
    "start": "python3 -m http.server 3456",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "eslint": "^8.57.1",
    "jsdom": "^29.1.1",
    "pinyin": "^4.0.0",
    "prettier": "^3.8.3",
    "terser": "^5.48.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  }
}
