{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-redeclare": "warn",
    "no-console": "warn",
    "no-extra-semi": "warn",
    "no-empty": "warn",
    "no-constant-condition": "warn",
    "no-unreachable": "warn",
    "no-unsafe-negation": "error",
    "no-dupe-keys": "error"
  },
  "globals": {
    "supabase": "readonly",
    "auth": "readonly"
  }
}
