# ============================================================
# Supabase Edge Function 本地开发密钥配置
#
# 使用方法：
#   1. 复制此文件为 supabase/.env
#   2. 填入真实密钥值
#   3. 运行 supabase functions serve --env-file supabase/.env
#
# 生产环境：
#   在 Supabase Dashboard → Settings → Edge Functions → Secrets
#   中逐一添加以下密钥，或使用 CLI：
#   supabase secrets set --env-file supabase/.env
# ============================================================

# --- 支付宝支付 ---
ALIPAY_APP_ID=2021xxxxxxxxxxxx
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
your-private-key-here
-----END PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
your-alipay-public-key-here
-----END PUBLIC KEY-----"
# 沙箱：https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 生产：https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# --- Supabase ---
# 注意：Supabase 禁止自定义 secret 以 SUPABASE_ 开头
PROJECT_URL=https://your-project.supabase.co
PROJECT_ANON_KEY=your-anon-key-here

# --- 前端 URL ---
FRONTEND_URL=http://localhost:5173

# --- AI 报告生成 ---
DEEPSEEK_API_KEY=sk-...

# --- Supabase 服务端密钥 ---
PROJECT_SERVICE_ROLE_KEY=sb-secret-...
