# ============================================================
# 专业星图 — 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# --- Supabase 配置（前端） ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- 前端 URL（支付宝支付完成后的回调地址） ---
FRONTEND_URL=https://your-domain.com

# ============================================================
# 以下变量在 Supabase Dashboard → Edge Functions → Secrets 中配置
# (本地开发时可通过 supabase secrets set 或 .env 文件设置)
# ============================================================

# --- 支付宝支付配置 ---
# 支付宝开放平台应用 ID
ALIPAY_APP_ID=2021xxxxxxxxxxxx

# 支付宝应用私钥（PKCS#8 或 PKCS#1 格式均可，自动检测转换）
# 生成方式：支付宝开放平台 → 密钥管理 → 应用密钥
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
your-private-key-here
-----END PRIVATE KEY-----"

# 支付宝公钥（验签用，从支付宝开放平台下载）
# 格式：SPKI (-----BEGIN PUBLIC KEY-----)
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
your-alipay-public-key-here
-----END PUBLIC KEY-----"

# 支付宝网关
# 生产环境：https://openapi.alipay.com/gateway.do
# 沙箱环境（测试用）：https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 支付宝异步通知回调 URL（可选，默认自动拼接为 {SUPABASE_URL}/functions/v1/alipay-notify）
# ALIPAY_NOTIFY_URL=

# --- AI 报告生成 ---
# DeepSeek API Key（用于 generate-report Edge Function）
# 获取位置：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# --- Supabase 服务端密钥 ---
# Service Role Key（用于 Edge Function 绕过 RLS 写入数据）
# 获取位置：Supabase Dashboard → Settings → API → service_role key
PROJECT_SERVICE_ROLE_KEY=sb-secret-...
